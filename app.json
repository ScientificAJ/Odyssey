{
  "expo": {
    "name": "Odyssey",
    "slug": "odyssey",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "odyssey",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.odyssey.local",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EAFBFF",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": true,
      "allowBackup": false,
      "package": "com.odyssey.local"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true,
          "enableFTS": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false,
          "faceIDPermission": "Allow Odyssey to protect your private local journey."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a private completion photo to store only inside Odyssey.",
          "cameraPermission": "Take a private completion photo to store only inside Odyssey.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF7A7A"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EAFBFF",
          "image": "./assets/images/odyssey-scenic-bg.png",
          "imageWidth": 220
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
